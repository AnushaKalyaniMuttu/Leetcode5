import java.util.*;

class Solution {
    public int minCost(int[] nums, int k) {

        int n = nums.length;
        int[] dp = new int[n + 1];

        Arrays.fill(dp, Integer.MAX_VALUE);
        dp[0] = 0;

        for (int i = 1; i <= n; i++) {

            Map<Integer, Integer> frequency = new HashMap<>();

            int trimmedLength = 0;

            for (int j = i; j >= 1; j--) {

                int num = nums[j - 1];

                int count = frequency.getOrDefault(num, 0) + 1;
                frequency.put(num, count);

                // If count becomes 2, both occurrences are trimmed.
                if (count == 2) {
                    trimmedLength += 2;
                }
                // Every occurrence after the second is also trimmed.
                else if (count > 2) {
                    trimmedLength++;
                }

                int currentCost = k + trimmedLength; 

                dp[i] = Math.min(
                    dp[i],
                    dp[j - 1] + currentCost
                );
            }
        }

        return dp[n];
    }
}
