class Solution {
    private static final int MOD = 1_000_000_007;

    public int beautifulPartitions(String s, int k, int minLength) {
        int n = s.length();

        if (!isPrime(s.charAt(0)) || isPrime(s.charAt(n - 1))) {
            return 0;
        }

        int[][] dp = new int[n + 1][k + 1];
        int[][] prefix = new int[n + 1][k + 1];

        dp[0][0] = 1;
        prefix[0][0] = 1;

        for (int i = 1; i <= n; i++) {
            if (i >= minLength &&
                !isPrime(s.charAt(i - 1)) &&
                (i == n || isPrime(s.charAt(i)))) {

                for (int j = 1; j <= k; j++) {
                    dp[i][j] = prefix[i - minLength][j - 1];
                }
            }

            for (int j = 0; j <= k; j++) {
                prefix[i][j] = (prefix[i - 1][j] + dp[i][j]) % MOD;
            }
        }

        return dp[n][k];
    }

    private boolean isPrime(char c) {
        return c == '2' || c == '3' || c == '5' || c == '7';
    }
}
