import java.util.*;

class Solution {
    public int[] maxPoints(int[][] grid, int[] queries) {
        int m = grid.length;
        int n = grid[0].length;

        int q = queries.length;
        int[][] sortedQueries = new int[q][2];

        for (int i = 0; i < q; i++) {
            sortedQueries[i][0] = queries[i];
            sortedQueries[i][1] = i;
        }

        Arrays.sort(sortedQueries, (a, b) -> a[0] - b[0]);

        int[] ans = new int[q];

        PriorityQueue<int[]> pq = new PriorityQueue<>(
            (a, b) -> a[0] - b[0]
        );

        boolean[][] visited = new boolean[m][n];

        pq.offer(new int[]{grid[0][0], 0, 0});
        visited[0][0] = true;

        int count = 0;
        int[][] dirs = {
            {1, 0}, {-1, 0},
            {0, 1}, {0, -1}
        };

        for (int[] query : sortedQueries) {
            int limit = query[0];

            while (!pq.isEmpty() && pq.peek()[0] < limit) {
                int[] curr = pq.poll();

                count++;

                int r = curr[1];
                int c = curr[2];

                for (int[] d : dirs) {
                    int nr = r + d[0];
                    int nc = c + d[1];

                    if (nr >= 0 && nr < m && nc >= 0 && nc < n 
                            && !visited[nr][nc]) {

                        visited[nr][nc] = true;
                        pq.offer(new int[]{grid[nr][nc], nr, nc});
                    }
                }
            }

            ans[query[1]] = count;
        }

        return ans;
    }
}
