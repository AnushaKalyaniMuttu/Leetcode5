class Solution {
    private int m, n, target;
    private int[][] grid;
    private Boolean[][][] memo;

    public boolean isThereAPath(int[][] grid) {
        this.grid = grid;
        m = grid.length;
        n = grid[0].length;

        int len = m + n - 1;
        if ((len & 1) == 1) {
            return false;
        }

        target = len / 2;
        memo = new Boolean[m][n][len + 1];

        return dfs(0, 0, 0);
    }

    private boolean dfs(int i, int j, int ones) {
        if (i >= m || j >= n) {
            return false;
        }

        ones += grid[i][j];

        if (ones > target || (i + j + 1 - ones) > target) {
            return false;
        }

        if (i == m - 1 && j == n - 1) {
            return ones == target;
        }

        if (memo[i][j][ones] != null) {
            return memo[i][j][ones];
        }

        return memo[i][j][ones] =
                dfs(i + 1, j, ones) || dfs(i, j + 1, ones);
    }
}
