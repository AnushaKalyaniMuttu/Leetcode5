class Solution {

    static final int MOD = 1_000_000_007;

    public int countPartitions(int[] nums, int k) {

        long total = 0;

        for (int num : nums) {
            total += num;
        }

        // Impossible to make both partitions >= k
        if (total < 2L * k) {
            return 0;
        }

        int[] dp = new int[k];

        dp[0] = 1;

        for (int num : nums) {

            for (int sum = k - 1; sum >= num; sum--) {
                dp[sum] = (dp[sum] + dp[sum - num]) % MOD;
            }
        }

        long invalid = 0;

        for (int i = 0; i < k; i++) {
            invalid = (invalid + dp[i]) % MOD;
        }


        long totalWays = modPow(2, nums.length);

        long ans = (totalWays - 2 * invalid) % MOD;

        if (ans < 0) {
            ans += MOD;
        }

        return (int) ans;
    }


    private long modPow(long a, long b) {

        long result = 1;

        while (b > 0) {

            if ((b & 1) == 1) {
                result = result * a % MOD;
            }

            a = a * a % MOD;
            b >>= 1;
        }

        return result;
    }
}
