class Solution {
    public int countGoodStrings(int low, int high, int zero, int one) {

        final int MOD = 1_000_000_007;

        long[] dp = new long[high + 1];

        dp[0] = 1;

        long answer = 0;

        for (int i = 0; i <= high; i++) {

            if (i >= low) {
                answer = (answer + dp[i]) % MOD;
            }

            if (i + zero <= high) {
                dp[i + zero] =
                    (dp[i + zero] + dp[i]) % MOD;
            }

            if (i + one <= high) {
                dp[i + one] =
                    (dp[i + one] + dp[i]) % MOD;
            }
        }

        return (int) answer;
    }
}
