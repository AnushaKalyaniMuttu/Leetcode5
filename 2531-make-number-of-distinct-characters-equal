class Solution {
    public boolean isItPossible(String word1, String word2) {

        int[] freq1 = new int[26];
        int[] freq2 = new int[26];

        for (char c : word1.toCharArray()) {
            freq1[c - 'a']++;
        }

        for (char c : word2.toCharArray()) {
            freq2[c - 'a']++;
        }

        for (int i = 0; i < 26; i++) {

            if (freq1[i] == 0) {
                continue;
            }

            for (int j = 0; j < 26; j++) {

                if (freq2[j] == 0) {
                    continue;
                }

                // If we swap the same character, nothing changes
                int distinct1 = 0;
                int distinct2 = 0;

                for (int k = 0; k < 26; k++) {
                    int f1 = freq1[k];
                    int f2 = freq2[k];

                    if (k == i) {
                        f1--;
                        f2++;
                    }

                    if (k == j) {
                        f1++;
                        f2--;
                    }

                    if (f1 > 0) {
                        distinct1++;
                    }

                    if (f2 > 0) {
                        distinct2++;
                    }
                }

                if (distinct1 == distinct2) {
                    return true;
                }
            }
        }

        return false;
    }
}
