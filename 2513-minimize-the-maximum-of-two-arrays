class Solution {

    public int minimizeSet(int divisor1, int divisor2,
                           int uniqueCnt1, int uniqueCnt2) {

        long left = 1;
        long right = (long) 2e10;

        long lcm = lcm(divisor1, divisor2);

        while (left < right) {
            long mid = left + (right - left) / 2;

            long count1 = mid - mid / divisor1;
            long count2 = mid - mid / divisor2;
            long common = mid - mid / lcm;

            if (count1 >= uniqueCnt1 &&
                count2 >= uniqueCnt2 &&
                common >= (long) uniqueCnt1 + uniqueCnt2) {

                right = mid;
            } else {
                left = mid + 1;
            }
        }

        return (int) left;
    }

    private long gcd(long a, long b) {
        while (b != 0) {
            long temp = a % b;
            a = b;
            b = temp;
        }
        return a;
    }

    private long lcm(long a, long b) {
        return a / gcd(a, b) * b;
    }
}
