class Solution {
    public int maximumValue(String[] strs) {
        int ans = 0;

        for (String s : strs) {
            boolean isNumber = true;

            for (char c : s.toCharArray()) {
                if (!Character.isDigit(c)) {
                    isNumber = false;
                    break;
                }
            }

            if (isNumber) {
                ans = Math.max(ans, Integer.parseInt(s));
            } else {
                ans = Math.max(ans, s.length());
            }
        }

        return ans;
    }
}
