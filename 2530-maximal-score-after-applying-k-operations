import java.util.*;

class Solution {
    public long maxKelements(int[] nums, int k) {
        PriorityQueue<Integer> maxHeap =
                new PriorityQueue<>(Collections.reverseOrder());

        for (int num : nums) {
            maxHeap.offer(num);
        }

        long score = 0;

        while (k-- > 0) {
            int max = maxHeap.poll();

            score += max;

            // ceil(max / 3)
            int newValue = (max + 2) / 3;

            maxHeap.offer(newValue);
        }

        return score;
    }
}
