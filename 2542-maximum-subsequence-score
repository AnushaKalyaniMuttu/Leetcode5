import java.util.*;

class Solution {
    public long maxScore(int[] nums1, int[] nums2, int k) {

        int n = nums1.length;

        // Store {nums1, nums2}
        int[][] pairs = new int[n][2];

        for (int i = 0; i < n; i++) {
            pairs[i][0] = nums1[i];
            pairs[i][1] = nums2[i];
        }

        // Sort by nums2 in descending order
        Arrays.sort(pairs, (a, b) -> Integer.compare(b[1], a[1]));

        PriorityQueue<Integer> minHeap = new PriorityQueue<>();

        long sum = 0;
        long answer = 0;

        for (int[] pair : pairs) {

            int num1 = pair[0];
            int num2 = pair[1];

            // Add nums1 to heap
            minHeap.offer(num1);
            sum += num1;

            // Keep only k largest nums1 values
            if (minHeap.size() > k) {
                sum -= minHeap.poll();
            }

            // We have exactly k elements
            if (minHeap.size() == k) {
                long score = sum * num2;
                answer = Math.max(answer, score);
            }
        }

        return answer;
    }
}
