class Solution {
    public boolean isReachable(int targetX, int targetY) {

        int gcd = gcd(targetX, targetY);

        while (gcd % 2 == 0) {
            gcd /= 2;
        }

        return gcd == 1;
    }

    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = a % b;
            a = b;
            b = temp;
        }

        return a;x
    }
}
