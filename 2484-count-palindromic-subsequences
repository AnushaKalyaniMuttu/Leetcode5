class Solution {
    public int countPalindromes(String s) {
        int n = s.length();
        int MOD = 1_000_000_007;

        long[][] left = new long[n][100];
        long[][] right = new long[n][100];

        // Build left pair counts
        int[] cnt = new int[10];
        for (int i = 0; i < n; i++) {
            if (i > 0) {
                System.arraycopy(left[i - 1], 0, left[i], 0, 100);
            }

            int d = s.charAt(i) - '0';

            for (int x = 0; x < 10; x++) {
                left[i][x * 10 + d] += cnt[x];
            }

            cnt[d]++;
        }

        // Build right pair counts
        cnt = new int[10];
        for (int i = n - 1; i >= 0; i--) {
            if (i < n - 1) {
                System.arraycopy(right[i + 1], 0, right[i], 0, 100);
            }

            int d = s.charAt(i) - '0';

            for (int x = 0; x < 10; x++) {
                right[i][x * 10 + d] += cnt[x];
            }

            cnt[d]++;
        }

        long ans = 0;

        // Choose each position as the middle character
        for (int i = 2; i <= n - 3; i++) {
            for (int p = 0; p < 100; p++) {
                ans = (ans + left[i - 1][p] * right[i + 1][p]) % MOD;
            }
        }

        return (int) ans;
    }
}
